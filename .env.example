# Environment Configuration for AgroKart BD
# Copy this to .env and update with your actual credentials

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id-goes-here
GOOGLE_CLIENT_SECRET=your-client-secret-goes-here
GOOGLE_REDIRECT_URI=http://localhost:3000/php/google_callback.php

# Database Configuration (if needed)
DB_HOST=localhost
DB_NAME=agrobd
DB_USER=root
DB_PASS=

# Other settings
APP_URL=http://localhost:3000
APP_ENV=development
